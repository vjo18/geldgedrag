---
import IconHash from "@/assets/icons/IconHash.svg";
import { getBasePath } from "@/utils/getBasePath";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={getBasePath(`/tags/${tag}/`)}
    class:list={[
      "surface-soft inline-flex items-center gap-1 rounded-full px-4 py-2 transition hover:-translate-y-0.5 hover:text-accent",
      { "text-sm": size === "sm" },
      { "text-base": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-4": size === "lg" },
        { "size-3.5": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
