---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-surface px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Ga naar inhoud
</a>

<header class="app-layout pt-6 sm:pt-8">
  <div
    class="surface flex flex-col justify-between px-5 py-4 sm:flex-row sm:items-center sm:px-6"
  >
    <div class="flex items-center justify-between gap-4">
      <a
        href={getBasePath("/")}
        class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
      >
        {SITE.title}
      </a>

      <button
        id="menu-btn"
        class="surface-soft ms-auto flex rounded-full p-2.5 sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
    </div>

    <nav id="nav-menu" class="mt-4 sm:mt-0">
      <ul
        id="menu-items"
        class:list={[
          "surface-soft mt-3 flex flex-col gap-2 p-2 font-heading text-sm font-medium sm:mt-0 sm:flex-row sm:items-center sm:gap-2 sm:bg-transparent sm:p-0 sm:text-base sm:shadow-none",
          "hidden sm:flex",
        ]}
      >
        {
          [
            [getBasePath("/posts"), "Artikels", isActive("/posts")],
            [getBasePath("/about"), "Over", isActive("/about")],
          ].map(([href, label, active]) => (
            <li>
              <a
                href={href as string}
                class:list={[
                  "block rounded-full px-4 py-2 transition-colors hover:text-accent",
                  { "bg-background text-accent shadow-sm": active },
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li class="flex items-center gap-2 pt-1 sm:pt-0">
          <LinkButton
            href={getBasePath("/search")}
            class:list={[
              "surface-soft flex rounded-full p-2.5 hover:text-accent",
              { "text-accent": isActive("/search") },
            ]}
            title="Zoeken"
            aria-label="Zoeken"
          >
            <IconSearch />
            <span class="sr-only">Zoeken</span>
          </LinkButton>
          {
            SITE.lightAndDarkMode && (
              <button
                id="theme-btn"
                class="surface-soft relative flex size-10 items-center justify-center rounded-full p-2 hover:text-accent"
                title="Wissel tussen light en dark mode"
                aria-label="light"
                aria-live="polite"
              >
                <IconMoon class="absolute scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            )
          }
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open menu" : "Sluit menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
