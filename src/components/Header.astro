---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconX from "@/assets/icons/IconX.svg";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";

const { pathname } = Astro.url;
const currentPath = pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0,-1) : pathname;
const active = (path:string) => currentPath === path || currentPath.startsWith(path + "/");
---

<a id="skip-to-content" href="#main-content" class="absolute start-4 -top-full z-50 bg-background px-3 py-2 text-accent focus:top-4">Ga naar inhoud</a>

<header class="app-layout pt-6 sm:pt-8">
  <div class="site-header">
    <a class="wordmark" href={getBasePath("/")} aria-label="Geldgedrag homepage">
      geld<span>&amp;</span>gedrag<span class="dot">.</span>
    </a>

    <button id="menu-btn" class="menu-button sm:hidden" aria-label="Open menu" aria-expanded="false">
      <IconMenuDeep id="menu-icon" />
      <IconX id="close-icon" class="hidden" />
    </button>

    <nav id="nav-menu" class="nav-wrap">
      <ul id="menu-items" class="nav-list hidden sm:flex">
        <li><a class:list={{"active-nav":active("/manifest")}} href={getBasePath("/manifest")}>Manifest</a></li>
        <li><a class:list={{"active-nav":active("/data")}} href={getBasePath("/data")}>Data</a></li>
        <li><a class:list={{"active-nav":active("/about")}} href={getBasePath("/about")}>Over</a></li>
        {SITE.lightAndDarkMode && (
          <li>
            <button id="theme-btn" class="theme-button" title="Wissel kleurmodus" aria-label="light" aria-live="polite">
              <IconMoon class="absolute scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          </li>
        )}
      </ul>
    </nav>
  </div>
</header>

<script>
  function setupMenu(){
    const btn=document.querySelector("#menu-btn");
    const items=document.querySelector("#menu-items");
    const menu=document.querySelector("#menu-icon");
    const close=document.querySelector("#close-icon");
    if(!btn||!items||!menu||!close)return;
    btn.addEventListener("click",()=>{
      const open=btn.getAttribute("aria-expanded")==="true";
      btn.setAttribute("aria-expanded",open?"false":"true");
      items.classList.toggle("hidden");
      menu.classList.toggle("hidden");
      close.classList.toggle("hidden");
    });
  }
  setupMenu();
  document.addEventListener("astro:after-swap",setupMenu);
</script>

<style>
  .site-header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);padding:1rem 0}
  .wordmark{font-family:var(--font-body);font-size:1.45rem;font-weight:600;letter-spacing:-.04em;text-decoration:none;color:var(--foreground)}
  .wordmark span{color:var(--accent)}
  .wordmark .dot{color:#e6a46c}
  .menu-button,.theme-button{position:relative;display:flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem}
  .nav-list{font-family:var(--font-heading);gap:1.5rem;align-items:center;font-size:.9rem;font-weight:600}
  .nav-list a{text-decoration:none;color:color-mix(in srgb,var(--foreground) 72%,transparent)}
  .nav-list a:hover,.nav-list a.active-nav{color:var(--accent)}
  @media(max-width:639px){.site-header{flex-wrap:wrap}.nav-wrap{width:100%}.nav-list{margin-top:1rem;flex-direction:column;align-items:flex-start;gap:.85rem;padding:1rem 0}.nav-list:not(.hidden){display:flex}}
</style>
