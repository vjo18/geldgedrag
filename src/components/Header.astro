---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Ga naar inhoud
</a>

<header class="app-layout pt-5 sm:pt-7">
  <div class="surface relative overflow-hidden px-5 py-4 sm:px-6">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-accent/45 to-transparent"
    >
    </div>
    <div class="flex items-center justify-between gap-4">
      <a href={getBasePath("/")} class="min-w-0">
        <span class="eyebrow block">Essay platform</span>
        <span
          class="mt-2 block font-heading text-xl font-semibold tracking-tight sm:text-2xl"
        >
          {SITE.title}
        </span>
      </a>

      <button
        id="menu-btn"
        class="focus-outline ms-auto flex rounded-full border border-border/70 bg-background/80 p-2 sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
    </div>

    <div
      class="mt-5 flex flex-col gap-4 border-t border-border/70 pt-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <nav id="nav-menu" class="min-w-0">
        <ul
          id="menu-items"
          class:list={[
            "mt-3 flex flex-col gap-2 font-heading text-sm font-medium sm:mt-0 sm:flex-row sm:flex-wrap sm:items-center sm:gap-2 sm:text-[0.95rem]",
            "hidden sm:flex",
          ]}
        >
          <li>
            <a
              href={getBasePath("/posts")}
              class:list={[
                "inline-flex rounded-full px-4 py-2 transition-colors hover:text-accent",
                { "bg-muted/70 text-accent": isActive("/posts") },
              ]}
            >
              Artikels
            </a>
          </li>
          <li>
            <a
              href={getBasePath("/about")}
              class:list={[
                "inline-flex rounded-full px-4 py-2 transition-colors hover:text-accent",
                { "bg-muted/70 text-accent": isActive("/about") },
              ]}
            >
              Over
            </a>
          </li>
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <LinkButton
          href={getBasePath("/search")}
          class:list={[
            "focus-outline inline-flex size-10 items-center justify-center rounded-full border border-border/70 bg-background/80 hover:text-accent",
            { "text-accent": isActive("/search") },
          ]}
          title="Zoeken"
          aria-label="Zoeken"
        >
          <IconSearch />
          <span class="sr-only">Zoeken</span>
        </LinkButton>
        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="focus-outline relative inline-flex size-10 items-center justify-center rounded-full border border-border/70 bg-background/80 hover:text-accent"
              title="Wissel tussen light en dark mode"
              aria-label="light"
              aria-live="polite"
            >
              <IconMoon class="absolute scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open menu" : "Sluit menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
