---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, tags = [], ...props } = data;
---

<li class="py-6 first:pt-2 last:pb-2">
  <article
    class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-6"
  >
    <a href={getPath(id, filePath)} class="group block min-w-0">
      <div
        class="flex flex-wrap items-center gap-2 font-heading text-xs font-semibold tracking-[0.18em] text-accent uppercase"
      >
        <span>Artikel</span>
        {tags[0] && <span class="text-foreground/45">• {tags[0]}</span>}
      </div>
      <Heading
        class="mt-3 font-heading text-2xl font-semibold tracking-tight text-foreground transition-colors group-hover:text-accent"
      >
        {title}
      </Heading>
      <p class="mt-3 max-w-2xl leading-8 text-foreground/78">{description}</p>
    </a>

    <div class="flex flex-col gap-4 sm:items-end sm:text-right">
      <Datetime {...props} class="text-foreground/70" />
      <a
        href={getPath(id, filePath)}
        class="inline-flex rounded-full border border-border/70 px-4 py-2 font-heading text-sm font-semibold text-accent transition-colors hover:border-accent/40 hover:bg-muted/55"
      >
        Lees artikel
      </a>
    </div>
  </article>
</li>
