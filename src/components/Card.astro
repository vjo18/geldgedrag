---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, ...props } = data;
---

<li class="my-6">
  <article
    class="surface h-full px-5 py-5 transition-transform duration-200 hover:-translate-y-0.5 sm:px-6 sm:py-6"
  >
    <a href={getPath(id, filePath)} class="group block">
      <Heading
        class="font-heading text-2xl font-semibold tracking-tight text-foreground transition-colors group-hover:text-accent"
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      >
        {title}
      </Heading>
      <div class="mt-3">
        <Datetime {...props} />
      </div>
      <p class="mt-4 leading-8 text-foreground/80">{description}</p>
      <span
        class="mt-4 inline-flex items-center text-sm font-medium text-accent"
      >
        Lees artikel →
      </span>
    </a>
  </article>
</li>
