---
const currentYear = new Date().getFullYear();
import { getBasePath } from "@/utils/getBasePath";
---
<footer class="app-layout pb-10 pt-12">
  <div class="site-footer">
    <div>
      <a class="footer-brand" href={getBasePath("/")}>geld&amp;gedrag.</a>
      <p>Een onafhankelijk project over geld, gedrag en tijd.</p>
    </div>
    <nav aria-label="Voetnavigatie">
      <a href={getBasePath("/begrijp-geld")}>Begrijp geld</a>
      <a href={getBasePath("/geld-in-cijfers")}>Geld in cijfers</a>
      <a href={getBasePath("/over")}>Over</a>
    </nav>
    <p class="copyright">© {currentYear} Geld & gedrag</p>
  </div>
</footer>
<style>
  .site-footer{border-top:1px solid var(--border);padding-top:2rem;display:grid;gap:1.5rem;color:color-mix(in srgb,var(--foreground) 68%,transparent);font-size:.9rem}
  .footer-brand{font-family:var(--font-body);font-size:1.25rem;font-weight:600;color:var(--foreground);text-decoration:none}
  .site-footer nav{display:flex;gap:1.25rem;font-family:var(--font-heading)}
  .site-footer nav a{color:inherit;text-decoration:none}
  .copyright{font-family:var(--font-heading);font-size:.8rem}
  @media(min-width:768px){.site-footer{grid-template-columns:1fr auto;align-items:end}.copyright{grid-column:1/-1}}
</style>