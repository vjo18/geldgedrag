---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout pb-8", { "mt-auto pt-12": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="surface flex flex-col gap-5 px-5 py-6 sm:flex-row sm:items-end sm:justify-between sm:px-6"
  >
    <div>
      <p class="eyebrow">Geld &amp; gedrag</p>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-foreground/78">
        Een rustige digitale publicatie over financiële educatie, psychologie en
        filosofie — ontworpen om traag te lezen.
      </p>
    </div>
    <div class="flex flex-col items-start gap-3 sm:items-end">
      <Socials />
      <p class="text-sm text-foreground/65">
        © {currentYear} Geld &amp; gedrag.
      </p>
    </div>
  </div>
</footer>
