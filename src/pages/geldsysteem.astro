---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`${SITE.title} | Geldsysteem`} description="De eeuwige schuldcyclus en financiële weerbaarheid.">
  <Header />
  <main id="main-content" class="app-layout pb-16">
    <section class="surface mt-6 gg-shell">
      <div class="hero">
        <div>
          <div class="hero-eyebrow">Geld · Schuld · Cyclus</div>
          <h1>De <em>oneindige</em><br />schuldcyclus</h1>
          <p class="hero-sub">De economie draait op lenen... Zo sluit de cirkel zich opnieuw.</p>
        </div>
      </div>
      <div class="divider"></div>
      <section class="reveal"><div class="section-label">01 — De motor</div><h2>Krediet als brandstof voor de economie</h2><p class="lead">Geld lenen is niet per definitie slecht.</p></section>
      <div class="divider"></div>
      <section class="reveal"><div class="section-label">02 — Keerzijde 1: De schuldspiraal</div><h2>Nieuw geld komt als schuld</h2><p class="lead">Wanneer banken leningen geven, schrijven ze geld bij uit het niets, als een schuld.</p></section>
      <div class="divider"></div>
      <section class="reveal">
        <div class="section-label">03 — Keerzijde 2: Ongelijkheid</div>
        <h2>Nieuw geld bereikt niet iedereen tegelijk</h2>
        <p class="lead">Richard Cantillon (1730): wie het nieuwe geld als eerste ontvangt, profiteert.</p>
        <div class="waterfall">
          <div class="wf-step"><div class="wf-num">1</div><h3>Overheid &amp; centrale bank</h3><p>Ontvangen of maken nieuw geld als eerste.</p></div>
          <div class="wf-step"><div class="wf-num">2</div><h3>Banken &amp; financiële markten</h3><p>Nieuw geld stroomt naar obligaties, aandelen en vastgoed.</p></div>
          <div class="wf-step"><div class="wf-num">3</div><h3>Bedrijven &amp; bezitters</h3><p>Wie activa bezit profiteert; inputkosten stijgen.</p></div>
          <div class="wf-step"><div class="wf-num">4</div><h3>Gewone burgers &amp; spaarders</h3><p>Consumptieprijzen stijgen en koopkracht daalt.</p></div>
        </div>
      </section>
      <div class="divider"></div>
      <section class="reveal"><div class="section-label">04 — Inflatie</div><h2>Inflatie: de onzichtbare belasting</h2><p class="lead">Inflatie is een structureel gevolg van hoe ons geldsysteem werkt.</p></section>
      <div class="divider"></div>
      <section class="reveal"><div class="section-label">05 — De verdeling</div><h2>Wie betaalt de prijs?</h2><div class="tiers"><div class="tier"><h3>Laag inkomen</h3></div><div class="tier"><h3>Middenklasse</h3></div><div class="tier"><h3>Vermogenden</h3></div><div class="tier"><h3>Dicht bij de geldkraan</h3></div></div></section>
      <div class="divider"></div>
      <section class="reveal"><div class="section-label">06 — De doorwerking</div><h2>Maatschappelijke gevolgen</h2><div class="impact-grid"><div class="impact-card"><h3>Financieel</h3></div><div class="impact-card"><h3>Psychologisch</h3></div><div class="impact-card"><h3>Gezondheid</h3></div><div class="impact-card"><h3>Gezin</h3></div><div class="impact-card"><h3>Sociaal</h3></div><div class="impact-card"><h3>Politiek</h3></div></div></section>
      <div class="divider"></div>
      <section class="reveal"><div class="section-label">07 — Het dilemma</div><h2>Twee zwarte beesten</h2><div class="beasts-grid"><div class="beast"><h3>Te weinig krediet</h3></div><div class="beast"><h3>Te veel krediet</h3></div></div></section>
      <div class="divider"></div>
      <section class="loop-section"><div class="section-label">08 — De kern</div><h2>De oneindige, zichzelf versterkende cyclus</h2></section>
      <div class="divider"></div>
      <section class="reveal"><div class="section-label">09 — Wat kan ik doen?</div><h2>Drie lagen van financiële weerbaarheid</h2></section>
    </section>
  </main>
  <Footer />
</Layout>

<style>
.gg-shell{padding:0;background:#f5f0e8;color:#0a0a0f;overflow:hidden}.hero{min-height:70svh;display:grid;place-items:center;text-align:center;padding:60px 24px;background:radial-gradient(ellipse 80% 60% at 50% 110%, rgba(201,146,42,.18) 0%, transparent 70%)}
.hero h1{font-family:var(--font-heading);font-size:clamp(42px,8vw,96px);line-height:1}.hero h1 em{color:#c9922a;font-style:italic}.hero-sub{max-width:720px;margin:20px auto;color:#6b6560}
.section-label{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#c9922a}.divider{height:1px;background:rgba(0,0,0,.12)}
.gg-shell>section{padding:80px 24px;max-width:1200px;margin:0 auto}.lead{color:#6b6560;max-width:720px}.waterfall,.tiers,.impact-grid,.beasts-grid{margin-top:32px;display:grid;gap:1px;background:rgba(0,0,0,.12);border:1px solid rgba(0,0,0,.12)}
.waterfall{grid-template-columns:repeat(4,1fr)}.tiers{grid-template-columns:repeat(4,1fr)}.impact-grid{grid-template-columns:repeat(3,1fr)}.beasts-grid{grid-template-columns:1fr 1fr}
.wf-step,.tier,.impact-card,.beast{background:#f5f0e8;padding:24px}.wf-num{font-size:40px;color:rgba(201,146,42,.3)}.loop-section{background:#0a0a0f;color:#f5f0e8;padding:80px 24px}
@media (max-width:900px){.waterfall,.tiers,.impact-grid,.beasts-grid{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.waterfall,.tiers,.impact-grid,.beasts-grid{grid-template-columns:1fr}}
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.1 });
  els.forEach((el) => obs.observe(el));
</script>
