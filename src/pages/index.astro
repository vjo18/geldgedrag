---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const recentPosts = getSortedPosts(posts).slice(0, SITE.postPerIndex);
---

<Layout
  title={`${SITE.title} | Psychologie, filosofie en financiële educatie`}
  description="Een rustig essayplatform over hoe geld onze keuzes, tijd en gedrag beïnvloedt."
>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <section class="surface mt-6 px-6 py-10 sm:mt-8 sm:px-10 sm:py-14">
      <h1
        class="max-w-4xl font-heading text-4xl font-semibold tracking-tight text-accent sm:text-6xl"
      >
        Begrijp geld. Begrijp jezelf. Begrijp de wereld.
      </h1>
      <div
        class="mt-8 max-w-3xl space-y-5 text-lg leading-9 text-foreground/88"
      >
        <p>
          Veel gesprekken over geld gaan over praktische vragen: hoe sparen, hoe
          investeren en hoeveel rendement halen. Dat zijn belangrijke
          onderwerpen. Maar daaronder ligt een diepere laag.
        </p>
        <p>
          We denken vaak dat geld vooral een financieel onderwerp is. Iets voor
          economen, banken of mensen die zich met investeren bezighouden. Maar
          geld heeft een veel bredere invloed op ons leven. Het raakt aan hoe we
          werken, hoe we consumeren, hoe we plannen maken voor de toekomst en
          zelfs hoe we omgaan met onze gezondheid en relaties.
        </p>
        <p>
          Geld beïnvloedt namelijk niet alleen onze financiële situatie. Het
          beïnvloedt ook hoe we met tijd en keuzes omgaan.
        </p>
      </div>

      <div
        class="mt-12 grid gap-8 border-y border-border/80 py-8 sm:grid-cols-3 sm:gap-10"
      >
        <div class="space-y-3">
          <p
            class="font-heading text-xs font-semibold tracking-[0.24em] text-accent uppercase"
          >
            Financiële educatie
          </p>
          <p class="leading-7 text-foreground/78">
            Heldere uitleg over geld, koopkracht, inflatie en vermogen.
          </p>
        </div>
        <div class="space-y-3">
          <p
            class="font-heading text-xs font-semibold tracking-[0.24em] text-accent uppercase"
          >
            Psychologie
          </p>
          <p class="leading-7 text-foreground/78">
            Ontdek waarom emoties en impulsen je financiële keuzes sturen, en
            hoe je dat patroon doorbreekt.
          </p>
        </div>
        <div class="space-y-3">
          <p
            class="font-heading text-xs font-semibold tracking-[0.24em] text-accent uppercase"
          >
            Filosofie
          </p>
          <p class="leading-7 text-foreground/78">
            Reflecteer over wat geld betekent voor een goed leven, en hoe het
            een middel blijft in plaats van een doel.
          </p>
        </div>
      </div>

      <p class="mt-10 max-w-3xl leading-8 text-foreground/80">
        Het doel is om deze thema’s toegankelijk te maken, zonder te vervallen
        in simplistische verklaringen of financieel advies. Het gaat vooral om
        begrijpen hoe de context werkt waarin we onze keuzes maken.
      </p>
    </section>

    <section class="surface mt-10 px-6 py-8 sm:px-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p
            class="font-heading text-sm font-semibold tracking-[0.2em] text-accent uppercase"
          >
            Laatste artikels
          </p>
          <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight">
            Begin bij het eerste essay
          </h2>
        </div>
        <LinkButton
          href={getBasePath("/posts")}
          class="font-heading text-sm text-accent"
        >
          Alle artikels
        </LinkButton>
      </div>
      <ul class="mt-6">
        {recentPosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
