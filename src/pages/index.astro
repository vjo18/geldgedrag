---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";

const chapters = [
  { n: "01", title: "Tijd", question: "Waar ruil je eigenlijk je leven voor?", text: "Onder iedere euro die je verdient zit ook iets schaarser: tijd die niet terugkomt." },
  { n: "02", title: "Geld", question: "Wat is datgene waarvoor we onze tijd ruilen?", text: "Waarom vertrouwen we geld, hoe bewaart het koopkracht en waarom verandert die koopkracht?" },
  { n: "03", title: "Krediet", question: "Waar komt nieuw geld vandaan?", text: "Leningen verbinden koopkracht vandaag met inkomen dat pas morgen verdiend wordt." },
  { n: "04", title: "Groei", question: "Waarom moet morgen bijna altijd meer zijn dan vandaag?", text: "Schuld, rente, productie en verwachtingen maken groei tot meer dan een statistiek." },
  { n: "05", title: "Bezit", question: "Waarom werkt bezit anders dan arbeid?", text: "Wie alleen tijd verkoopt en wie ook bezit opbouwt, ervaart dezelfde economie anders." },
  { n: "06", title: "Gedrag", question: "Wat doet die omgeving met ons?", text: "Schaarste, vergelijking, status en angst beïnvloeden financiële keuzes." },
  { n: "07", title: "Genoeg", question: "Waarom zegt geld nooit vanzelf: stop?", text: "Meer is meetbaar. Genoeg vraagt een oordeel over wat je werkelijk wilt beschermen." },
  { n: "08", title: "Vrijheid", question: "Wat koop je uiteindelijk met vermogen?", text: "Niet alleen spullen, maar ook mogelijkheden: wachten, kiezen, zorgen, weigeren en veranderen." },
];
---

<Layout
  title={`${SITE.title} | Geld, gedrag en tijd`}
  description="Geldgedrag onderzoekt hoe ons geldsysteem werkt, hoe het ons gedrag beïnvloedt en wat dat betekent voor de manier waarop we onze tijd gebruiken."
>
  <Header />

  <main id="main-content" class="app-layout pb-16">
    <section class="hero-panel mt-6">
      <div class="hero-copy">
        <p class="eyebrow">Geld · gedrag · tijd</p>
        <h1>We werken voor geld.<br /><em>Maar wat werkt geld met ons?</em></h1>
        <p class="lead">
          Geld bepaalt waar we wonen, hoeveel we werken, wat we bewaren voor later
          en welke risico's we durven nemen. Toch leren we opmerkelijk weinig over
          het systeem waarin dat geld ontstaat.
        </p>
        <p class="lead">
          Geldgedrag is een onderzoek naar geld, tijd en de keuzes die daaruit voortkomen.
        </p>
        <div class="hero-actions">
          <a class="primary-link" href={getBasePath("/manifest")}>Begin bij het manifest →</a>
          <a class="quiet-link" href={getBasePath("/data")}>Bekijk de data</a>
        </div>
      </div>

      <aside class="time-card" aria-label="Voorbeeld van geld uitgedrukt in tijd">
        <p class="eyebrow">Een andere prijs</p>
        <p class="time-amount">€160</p>
        <div class="time-rule"></div>
        <p class="time-result">8 uur</p>
        <p class="time-note">bij €20 netto per gewerkt uur</p>
      </aside>
    </section>

    <section class="statement-block">
      <p class="eyebrow">Een vertrekpunt</p>
      <h2>Geld is ook opgeslagen tijd.</h2>
      <div class="statement-copy">
        <p>
          Als je werkt, ruil je een deel van je tijd en energie voor geld.
          Wanneer je niet alles uitgeeft, probeer je een deel van die inspanning
          mee te nemen naar de toekomst.
        </p>
        <p>
          Een reserve kan een onverwachte rekening betalen. Vermogen kan ruimte
          geven om minder te werken, voor iemand te zorgen of een andere richting
          te kiezen. Geld is daarom meer dan een getal. Het verplaatst mogelijkheden door de tijd.
        </p>
      </div>
    </section>

    <section class="journey-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Het manifest</p>
          <h2>Acht vragen. Eén verhaal.</h2>
        </div>
        <p>
          Geen losse artikelen, maar een ontdekkingstocht van tijd naar geld,
          van geld naar systeem en uiteindelijk terug naar de vraag hoe je wilt leven.
        </p>
      </div>

      <div class="chapter-grid">
        {chapters.map(chapter => (
          <article class="chapter-card">
            <span>{chapter.n}</span>
            <p class="chapter-kicker">{chapter.title}</p>
            <h3>{chapter.question}</h3>
            <p>{chapter.text}</p>
          </article>
        ))}
      </div>

      <a class="primary-link mt-link" href={getBasePath("/manifest")}>Lees het manifest →</a>
    </section>

    <section class="data-panel">
      <div>
        <p class="eyebrow">Data</p>
        <h2>Je hoeft niemand op zijn woord te geloven.</h2>
        <p class="data-intro">
          Het manifest vertelt waarom een cijfer ertoe doet. De datalaag laat je
          zelf kijken naar koopkracht, wonen, geldhoeveelheid, rente, schuld en bezit.
        </p>
        <a class="quiet-link light-link" href={getBasePath("/data")}>Open Geld in cijfers →</a>
      </div>

      <div class="mini-data-grid">
        <div>
          <span>Koopkracht</span>
          <strong>€100 → €67</strong>
          <small>20 jaar bij 2% inflatie, zonder rente</small>
        </div>
        <div>
          <span>Wonen</span>
          <strong>Loon ↔ woningprijs</strong>
          <small>Wie houdt wie bij?</small>
        </div>
        <div>
          <span>Geld</span>
          <strong>M1 · M2 · M3</strong>
          <small>Hoeveel geld bestaat er?</small>
        </div>
      </div>
    </section>

    <section class="closing-statement">
      <p>Geld kun je opnieuw verdienen.</p>
      <h2>Tijd niet.</h2>
      <p class="closing-copy">
        De belangrijkste financiële vraag is daarom niet alleen hoeveel geld je
        kunt verzamelen, maar hoeveel zeggenschap je wilt houden over de tijd die je hebt.
      </p>
      <a class="primary-link" href={getBasePath("/manifest")}>Begin bij het manifest →</a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero-panel{margin-top:1.5rem;display:grid;gap:3rem;padding:clamp(2rem,6vw,5rem) 0 4rem;border-bottom:1px solid var(--border)}
  .hero-copy{max-width:48rem}
  .eyebrow{font-family:var(--font-heading);font-size:.75rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}
  h1,h2,h3{font-family:var(--font-body)}
  h1{margin-top:1rem;font-size:clamp(3.2rem,8vw,7.2rem);line-height:.96;letter-spacing:-.055em;font-weight:500}
  h1 em{font-weight:400;color:var(--accent);font-style:italic}
  .lead{margin-top:1.5rem;max-width:43rem;font-size:clamp(1.08rem,2vw,1.35rem);line-height:1.75;color:color-mix(in srgb,var(--foreground) 78%,transparent)}
  .hero-actions{display:flex;flex-wrap:wrap;gap:1.25rem;align-items:center;margin-top:2rem}
  .primary-link,.quiet-link{font-family:var(--font-heading);font-weight:650;text-decoration:none}
  .primary-link{display:inline-flex;padding:.85rem 1.1rem;border:1px solid var(--accent);background:var(--accent);color:#fff}
  .quiet-link{color:var(--foreground);border-bottom:1px solid var(--border);padding-bottom:.25rem}
  .time-card{align-self:end;border-left:1px solid var(--border);padding-left:2rem}
  .time-amount,.time-result{font-family:var(--font-heading);font-size:clamp(2.5rem,6vw,4.5rem);font-weight:700;letter-spacing:-.05em}
  .time-rule{height:1px;background:var(--border);margin:.8rem 0}
  .time-note{color:color-mix(in srgb,var(--foreground) 60%,transparent);font-size:.9rem}
  .statement-block,.journey-section,.closing-statement{padding:clamp(4rem,8vw,8rem) 0}
  .statement-block h2,.journey-section h2,.data-panel h2,.closing-statement h2{margin-top:.75rem;font-size:clamp(2.4rem,6vw,5.2rem);line-height:1.03;letter-spacing:-.045em;font-weight:500}
  .statement-copy{margin-top:2rem;display:grid;gap:1.5rem;max-width:52rem;font-size:1.15rem;line-height:1.8;color:color-mix(in srgb,var(--foreground) 78%,transparent)}
  .journey-section{border-top:1px solid var(--border)}
  .section-heading{display:grid;gap:2rem;align-items:end}
  .section-heading>p{max-width:34rem;line-height:1.7;color:color-mix(in srgb,var(--foreground) 68%,transparent)}
  .chapter-grid{display:grid;grid-template-columns:1fr;margin-top:3rem;border-top:1px solid var(--border)}
  .chapter-card{padding:1.5rem 0;border-bottom:1px solid var(--border)}
  .chapter-card>span{font-family:var(--font-heading);color:var(--accent);font-size:.75rem}
  .chapter-kicker{font-family:var(--font-heading);font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:.72rem;margin-top:.8rem}
  .chapter-card h3{font-size:1.45rem;line-height:1.2;margin-top:.65rem;font-weight:500}
  .chapter-card>p:last-child{margin-top:.8rem;line-height:1.65;color:color-mix(in srgb,var(--foreground) 68%,transparent)}
  .mt-link{margin-top:2rem}
  .data-panel{display:grid;gap:3rem;background:#173c34;color:#f6f2e9;padding:clamp(2rem,6vw,4.5rem);margin-inline:calc(50% - 50vw);padding-inline:max(calc((100vw - min(100% - 2.5rem,64rem))/2),1.25rem)}
  .data-panel .eyebrow{color:#e6a46c}
  .data-intro{max-width:42rem;margin-top:1.5rem;font-size:1.1rem;line-height:1.75;color:rgba(246,242,233,.78)}
  .light-link{display:inline-block;margin-top:1.5rem;color:#f6f2e9;border-color:rgba(246,242,233,.35)}
  .mini-data-grid{display:grid;gap:1rem}
  .mini-data-grid div{padding:1.25rem;border:1px solid rgba(246,242,233,.18)}
  .mini-data-grid span,.mini-data-grid small{display:block;font-family:var(--font-heading)}
  .mini-data-grid span{font-size:.7rem;text-transform:uppercase;letter-spacing:.15em;color:#e6a46c}
  .mini-data-grid strong{display:block;font-family:var(--font-body);font-size:1.7rem;font-weight:500;margin:.75rem 0}
  .mini-data-grid small{color:rgba(246,242,233,.6)}
  .closing-statement{text-align:center}
  .closing-statement>p:first-child{font-family:var(--font-body);font-size:clamp(1.8rem,4vw,3.5rem)}
  .closing-copy{max-width:42rem;margin:1.5rem auto 2rem;font-size:1.1rem;line-height:1.8;color:color-mix(in srgb,var(--foreground) 70%,transparent)}
  @media(min-width:768px){.hero-panel{grid-template-columns:1.6fr .7fr}.section-heading{grid-template-columns:1.2fr .8fr}.chapter-grid{grid-template-columns:repeat(2,1fr)}.chapter-card{padding:2rem}.chapter-card:nth-child(odd){border-right:1px solid var(--border)}.data-panel{grid-template-columns:1.15fr .85fr;align-items:center}.mini-data-grid{grid-template-columns:1fr}}
</style>
