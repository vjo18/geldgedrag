---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const recentPosts = getSortedPosts(posts).slice(0, SITE.postPerIndex);
---

<Layout
  title={`${SITE.title} | Psychologie, filosofie en financiële educatie`}
  description="Een rustig essayplatform over hoe geld onze keuzes, tijd en gedrag beïnvloedt."
>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <section class="surface mt-6 px-6 py-10 sm:mt-8 sm:px-10 sm:py-14">
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(18rem,0.7fr)] lg:items-start"
      >
        <div>
          <p class="section-kicker">
            Essayplatform over geld en menselijk gedrag
          </p>
          <h1
            class="mt-5 max-w-3xl font-heading text-4xl font-semibold tracking-tight sm:text-6xl"
          >
            Geld & gedrag
          </h1>
          <div
            class="mt-8 max-w-3xl space-y-5 text-lg leading-9 text-foreground/88"
          >
            <p>
              Veel gesprekken over geld gaan over praktische vragen: hoe sparen,
              hoe investeren en hoeveel rendement halen. Dat zijn belangrijke
              onderwerpen. Maar daaronder ligt een diepere laag.
            </p>
            <p>
              We denken vaak dat geld vooral een financieel onderwerp is. Iets
              voor economen, banken of mensen die zich met investeren
              bezighouden. Maar geld heeft een veel bredere invloed op ons
              leven. Het raakt aan hoe we werken, hoe we consumeren, hoe we
              plannen maken voor de toekomst en zelfs hoe we omgaan met onze
              gezondheid en relaties.
            </p>
            <p>
              Geld beïnvloedt namelijk niet alleen onze financiële situatie. Het
              beïnvloedt ook hoe we met tijd en keuzes omgaan.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <LinkButton
              href={getBasePath("/posts")}
              class="rounded-full bg-foreground px-5 py-3 font-heading text-sm text-background transition hover:opacity-90"
            >
              Lees de artikels
            </LinkButton>
            <LinkButton
              href={getBasePath("/about")}
              class="surface-soft rounded-full px-5 py-3 font-heading text-sm"
            >
              Meer over deze website
            </LinkButton>
          </div>
        </div>

        <aside class="surface-soft p-5 sm:p-6">
          <p class="section-kicker">Focus</p>
          <div class="mt-5 space-y-4">
            <div class="surface bg-background/70 px-5 py-5">
              <h2 class="font-heading text-lg font-semibold">
                Financiële educatie
              </h2>
              <p class="mt-3 leading-7 text-foreground/78">
                Heldere uitleg over geld, koopkracht, inflatie en vermogen.
              </p>
            </div>
            <div class="surface bg-background/70 px-5 py-5">
              <h2 class="font-heading text-lg font-semibold">Psychologie</h2>
              <p class="mt-3 leading-7 text-foreground/78">
                Ontdek waarom emoties en impulsen je financiële keuzes sturen,
                en hoe je dat patroon doorbreekt.
              </p>
            </div>
            <div class="surface bg-background/70 px-5 py-5">
              <h2 class="font-heading text-lg font-semibold">Filosofie</h2>
              <p class="mt-3 leading-7 text-foreground/78">
                Reflecteer over wat geld betekent voor een goed leven, en hoe
                het een middel blijft in plaats van een doel.
              </p>
            </div>
          </div>
        </aside>
      </div>

      <p class="mt-10 max-w-3xl leading-8 text-foreground/80">
        Het doel is om deze thema’s toegankelijk te maken, zonder te vervallen
        in simplistische verklaringen of financieel advies. Het gaat vooral om
        begrijpen hoe de context werkt waarin we onze keuzes maken.
      </p>
    </section>

    <section class="surface mt-10 px-6 py-8 sm:px-8 sm:py-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-kicker">Laatste artikels</p>
          <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight">
            Begin bij het eerste essay
          </h2>
        </div>
        <LinkButton
          href={getBasePath("/posts")}
          class="surface-soft rounded-full px-4 py-2 font-heading text-sm text-accent"
        >
          Alle artikels
        </LinkButton>
      </div>
      <ul class="mt-6 grid gap-4 lg:grid-cols-2">
        {recentPosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
