---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const startHerePosts = getSortedPosts(posts)
  .filter(({ data }) => data.featured)
  .slice(0, SITE.postPerIndex);
---

<Layout
  title={`${SITE.title} | Psychologie, filosofie en financiële educatie`}
  description="Een rustig essayplatform over hoe geld onze keuzes, tijd en gedrag beïnvloedt."
>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <section class="surface mt-6 px-6 py-8 sm:px-10 sm:py-12">
      <h1
        class="max-w-3xl font-heading text-4xl font-semibold tracking-tight text-accent"
      >
        Over hoe geld ons gedrag stuurt
      </h1>
      <div class="article-copy mt-6 max-w-3xl space-y-5 text-foreground/80">
        <p>
          We denken vaak dat geld vooral een financieel onderwerp is. Iets voor
          economen, banken of mensen die zich met investeren bezighouden. Maar
          geld heeft een veel bredere invloed op ons leven. Het raakt aan hoe we
          werken, hoe we consumeren, hoe we plannen maken voor de toekomst en
          zelfs hoe we omgaan met onze gezondheid en relaties.
        </p>
        <p>
          Geld beïnvloedt namelijk niet alleen onze financiële situatie. Het
          beïnvloedt ook hoe we met tijd en keuzes omgaan.
        </p>
      </div>

      <div
        class="mt-12 grid gap-8 border-y border-border/80 py-8 sm:grid-cols-3 sm:gap-10"
      >
        <div class="space-y-3">
          <p
            class="font-heading text-sm font-semibold tracking-[0.24em] text-accent uppercase"
          >
            Financiële educatie
          </p>
          <p class="article-copy text-foreground/78">
            Heldere uitleg over geld, koopkracht, inflatie en vermogen.
          </p>
        </div>
        <div class="space-y-3">
          <p
            class="font-heading text-sm font-semibold tracking-[0.24em] text-accent uppercase"
          >
            Psychologie
          </p>
          <p class="article-copy text-foreground/78">
            Ontdek waarom emoties en impulsen je financiële keuzes sturen.
          </p>
        </div>
        <div class="space-y-3">
          <p
            class="font-heading text-sm font-semibold tracking-[0.24em] text-accent uppercase"
          >
            Filosofie
          </p>
          <p class="article-copy text-foreground/78">
            Reflecteer over wat geld betekent voor een goed leven.
          </p>
        </div>
      </div>

      <p class="article-copy mt-10 max-w-3xl text-foreground/80">
        Het doel is om deze thema’s toegankelijk te maken, zonder te vervallen
        in simplistische verklaringen of financieel advies. Het gaat vooral om
        begrijpen hoe de context werkt waarin we onze keuzes maken.
      </p>
    </section>



    <section class="surface mt-10 border border-accent/25 bg-accent/5 px-6 py-8 sm:px-10 sm:py-10">
      <p class="font-heading text-sm font-semibold tracking-[0.2em] text-accent uppercase">
        Nieuw: Geldsysteem
      </p>
      <h2 class="mt-3 max-w-3xl font-heading text-3xl font-semibold tracking-tight text-accent">
        Bekijk het overzicht van het geldsysteem
      </h2>
      <p class="article-copy mt-4 max-w-3xl text-foreground/80">
        Wil je eerst het grotere plaatje zien? Op de pagina <strong>Geldsysteem</strong>
        vind je een visueel overzicht van de schuldcyclus, inflatie, het Cantillon-effect
        en hoe dit alles samenhangt. Deze pagina is de kapstok voor de rest van de
        artikelen op deze website.
      </p>
      <div class="mt-6">
        <LinkButton href={getBasePath("/geldsysteem")} class="font-heading text-sm text-accent">
          Naar Geldsysteem
        </LinkButton>
      </div>
    </section>

    <section class="surface mt-10 px-6 py-8 sm:px-8">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-heading text-3xl font-semibold tracking-tight">
          Start hier
        </h2>
        <LinkButton
          href={getBasePath("/posts")}
          class="font-heading text-sm text-accent"
        >
          Alle artikels
        </LinkButton>
      </div>
      <ul class="mt-6">
        {startHerePosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
