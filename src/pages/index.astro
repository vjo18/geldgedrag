---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const startHerePosts = getSortedPosts(posts)
  .filter(({ data }) => data.featured)
  .slice(0, SITE.postPerIndex);
---

<Layout
  title={`${SITE.title} | Psychologie, filosofie en financiële educatie`}
  description="Een rustig essayplatform over hoe geld onze keuzes, tijd en gedrag beïnvloedt."
>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <section class="surface mt-6 px-6 py-8 sm:px-10 sm:py-12">
      <h1
        class="max-w-3xl font-heading text-[clamp(2.5rem,7vw,4.75rem)] leading-[1.02] font-semibold tracking-[-0.04em] text-foreground [&_em]:text-accent [&_em]:italic"
      >
        Over hoe <em>geld</em> ons <em>gedrag</em> stuurt
      </h1>
      <div class="article-copy mt-6 max-w-3xl space-y-5 text-foreground/80">
        <p>
          We denken vaak dat geld vooral een financieel onderwerp is. Iets voor
          economen, banken of mensen die zich met investeren bezighouden. Maar
          geld heeft een veel bredere invloed op ons leven. Het raakt aan hoe we
          werken, hoe we consumeren, hoe we plannen maken voor de toekomst en
          zelfs hoe we omgaan met onze gezondheid en relaties.
        </p>
        <p>
          Geld beïnvloedt namelijk niet alleen onze financiële situatie. Het
          beïnvloedt ook hoe we met tijd en keuzes omgaan.
        </p>
      </div>

      <div class="mt-12 grid gap-8 border-y border-border/80 py-8 sm:grid-cols-3 sm:gap-10">
        <div class="space-y-3">
          <p class="font-heading text-sm font-semibold tracking-[0.24em] text-accent uppercase">
            Economie
          </p>
          <p class="article-copy text-foreground/78">
            Begrijp hoe geld, krediet, inflatie en groei met elkaar samenhangen.
          </p>
        </div>
        <div class="space-y-3">
          <p class="font-heading text-sm font-semibold tracking-[0.24em] text-accent uppercase">
            Psychologie
          </p>
          <p class="article-copy text-foreground/78">
            Ontdek hoe schaarste, vergelijking en onzekerheid onze keuzes sturen.
          </p>
        </div>
        <div class="space-y-3">
          <p class="font-heading text-sm font-semibold tracking-[0.24em] text-accent uppercase">
            Filosofie
          </p>
          <p class="article-copy text-foreground/78">
            Denk na over geld, tijd, genoeg en de ruimte om anders te kiezen.
          </p>
        </div>
      </div>

      <p class="article-copy mt-10 max-w-3xl text-foreground/80">
        Het doel is niet om één financieel product of één verklaring als antwoord
        te geven. Het gaat vooral om begrijpen hoe de context werkt waarin we
        onze keuzes maken.
      </p>
    </section>

    <section class="surface mt-10 overflow-hidden border border-accent/20">
      <div class="grid gap-0 sm:grid-cols-2">
        <div class="flex flex-col justify-between gap-6 px-6 py-8 sm:px-10 sm:py-10">
          <div>
            <h2 class="font-heading text-[clamp(2rem,5vw,3.25rem)] leading-[1.1] font-semibold tracking-[-0.04em]">
              Systeem
            </h2>
            <p class="article-copy mt-4 leading-relaxed text-foreground/75">
              Een doorlopende tekst over geld, tijd, krediet, groei, bezit,
              gedrag en vrijheid. Geen losse artikels, maar één verhaal.
            </p>
          </div>
          <div>
            <a
              href={getBasePath("/systeem")}
              class="inline-flex items-center gap-2 rounded-lg border border-accent/30 bg-accent/8 px-5 py-2.5 font-heading text-sm font-semibold text-accent transition-colors hover:border-accent/50 hover:bg-accent/15"
            >
              Lees Systeem →
            </a>
          </div>
        </div>

        <div class="flex items-center justify-center border-t border-accent/10 bg-foreground/[0.02] px-6 py-10 sm:border-t-0 sm:border-l sm:px-8">
          <div class="w-full max-w-xs space-y-4">
            {["Tijd","Geld","Krediet","Groei","Bezit","Gedrag","Genoeg","Vrijheid"].map((label, i) => (
              <div class="flex items-center gap-3">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-accent/25 font-heading text-xs font-bold text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="font-heading text-sm font-semibold">{label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="surface mt-10 px-6 py-8 sm:px-10 sm:py-10">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-heading text-sm font-semibold tracking-[0.18em] text-accent uppercase">
            Data
          </p>
          <h2 class="mt-2 font-heading text-[clamp(2rem,5vw,3.25rem)] leading-[1.1] font-semibold tracking-[-0.04em]">
            Kijk zelf naar de cijfers
          </h2>
          <p class="article-copy mt-4 max-w-2xl text-foreground/75">
            Koopkracht, wonen, geldhoeveelheid, rente, schuld en bezit.
            De datalaag groeit mee met het verhaal.
          </p>
        </div>
        <a
          href={getBasePath("/data")}
          class="font-heading text-sm font-semibold text-accent"
        >
          Open Data →
        </a>
      </div>
    </section>

    <section class="surface mt-10 px-6 py-8 sm:px-8">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-heading text-[clamp(2rem,5vw,3.25rem)] leading-[1.1] font-semibold tracking-[-0.04em]">
          Lees meer
        </h2>
        <LinkButton href={getBasePath("/posts")} class="font-heading text-sm text-accent">
          Alle artikels
        </LinkButton>
      </div>
      <ul class="mt-6">
        {startHerePosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
