---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{ title: string; description?: string }>;

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description ?? SITE.desc}
>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <section id="about" class="surface mt-6 px-6 py-8 sm:px-10 sm:py-12">
      <div class="app-prose prose-img:border-0">
        <h1
          class="font-heading text-4xl font-semibold tracking-tight text-accent"
        >
          {frontmatter.title}
        </h1>
        <slot />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
