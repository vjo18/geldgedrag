---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{ title: string; description?: string }>;

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description ?? SITE.desc}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <section id="about" class="surface mt-6 px-6 py-8 sm:px-10 sm:py-12">
      <p
        class="font-heading text-sm font-semibold tracking-[0.24em] text-accent uppercase"
      >
        Over deze website
      </p>
      <div class="app-prose mt-5 prose-img:border-0">
        <h1 class="font-heading text-3xl tracking-tight sm:text-5xl">
          {frontmatter.title}
        </h1>
        <slot />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
